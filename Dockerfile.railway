FROM python:3.11-slim

# Install system dependencies (minimal set)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements first for better layer caching
COPY requirements_railway.txt requirements.txt

# Install PyTorch CPU-only version (much smaller and faster)
# This is the key optimization - CPU-only wheels are ~200MB vs ~800MB for CUDA
RUN pip install --no-cache-dir \
    torch==2.8.0 torchvision==0.23.0 \
    --index-url https://download.pytorch.org/whl/cpu

# Install remaining dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY app_railway.py app.py
# Copy ALL Python modules — avoids the recurring "forgot a COPY line" boot crash.
# (app_railway.py is also copied to app.py above for the gunicorn entrypoint.)
COPY *.py .
COPY models/ models/
COPY reference_images/ reference_images/
COPY static/ static/
COPY templates/ templates/

# Create storage directory
RUN mkdir -p storage

# Expose port
ENV PORT=8080
EXPOSE 8080

# Run with gunicorn
# Use shell form to properly expand $PORT
CMD gunicorn --bind 0.0.0.0:${PORT} --workers 1 --threads 8 --timeout 0 app:app

# Ignore Python virtual environments
venv/
venv-linux/

# Microsoft Building Footprints download cache (large, ephemeral)
.ms_footprint_cache/

# Ignore Python cache
__pycache__/
*.pyc

# Ignore local config
config.py

# Ignore deployed service manifest (may contain secrets)
service.yaml

# Ignore trained model weights by default (large; experimental weights stay local)
models/*.pt
# ...but the two production ensemble weights (MODEL_PATHS) MUST ship in the image:
# Railway builds from GitHub, so anything not committed is absent from the container.
!models/rooftop_model.pt
!models/rooftop_model_prev.pt

# Secrets and env files
.env
.env.local
.env.*.local
*.env

# Test artifacts
math_test*.jpg
test_esb.jpg
pipeline_test_outputs/
test_addresses_local.csv
geometry (1).py

# Sensitive / local-only files (do not publish on public fork)
Existing_Market_TAM.xlsx
jobs.db
storage/
temp_uploads/
training_images/
training_addresses.csv
training_setup/
download_training_images.py
.gitattributes

# Scratch / one-off validation files (Phase 3, throwaway)
scratch_*.py
scratch_*.csv
scratch_*.html
scratch_*.md
scratch_*.log
scratch_*.json
scratch_*.jsonl
scratch_results.json
scratch_*/
smoke_*.py

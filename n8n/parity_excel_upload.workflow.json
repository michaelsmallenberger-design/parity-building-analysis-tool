{
  "name": "Parity Cooling Tower - Excel Upload to Render",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Cooling Tower Analysis",
        "formDescription": "Upload an Excel or CSV file with building addresses.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "file",
              "fieldType": "file",
              "requiredField": true,
              "acceptFileTypes": ".xlsx,.xls,.csv"
            },
            {
              "fieldLabel": "title",
              "fieldType": "text",
              "requiredField": false,
              "placeholder": "Cooling Tower Analysis"
            },
            {
              "fieldLabel": "email",
              "fieldType": "email",
              "requiredField": true,
              "placeholder": "recipient@company.com"
            }
          ]
        },
        "responseMode": "onReceived",
        "responseData": "={{ { \"status\": \"started\", \"message\": \"Report is running. The finished HTML report will be emailed when Render is done.\" } }}",
        "options": {}
      },
      "id": "node-form-upload",
      "name": "Upload Excel",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [-360, 280],
      "webhookId": "parity-cooling-tower-excel-upload",
      "notes": "Users submit the spreadsheet here. Required file field name: file. Optional title. Required recipient email."
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binary = item.binary || {};\nconst sourceKey = binary.file ? 'file' : Object.keys(binary)[0];\nif (!sourceKey) {\n  throw new Error('No uploaded file found. Check the Form Trigger file field.');\n}\nreturn [{\n  json: item.json,\n  binary: {\n    file: binary[sourceKey]\n  }\n}];"
      },
      "id": "node-normalize-upload",
      "name": "Normalize uploaded file",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-220, 280],
      "notes": "Ensures the uploaded binary is always named file before the HTTP Request node sends it to Render."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://REPLACE-WITH-RENDER-SERVICE.onrender.com/api/run-file",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "REPLACE_WITH_ANALYZE_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "file"
            },
            {
              "name": "title",
              "value": "={{ $json.title || 'Cooling Tower Analysis' }}"
            }
          ]
        },
        "options": {
          "timeout": 1800000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "node-render-run-file",
      "name": "Analyze on Render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 280],
      "notes": "Forwards the uploaded spreadsheet to Render. Render parses the file, runs the analysis, and returns the finished HTML report as text."
    },
    {
      "parameters": {
        "sendTo": "={{ $('Upload Excel').item.json.email }}",
        "subject": "={{ ($('Upload Excel').item.json.title || 'Cooling Tower Analysis') + ' Report' }}",
        "emailType": "html",
        "message": "={{ $json.data }}",
        "options": {}
      },
      "id": "node-email-report",
      "name": "Email report",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [300, 280],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE",
          "name": "Gmail account"
        }
      },
      "notes": "Sends the returned HTML report to the email address entered in the upload form."
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "REPLACE_WITH_SLACK_CHANNEL_ID",
          "mode": "id"
        },
        "text": "=Cooling tower analysis complete for {{ $('Upload Excel').item.json.email }}.",
        "otherOptions": {}
      },
      "id": "node-slack-confirmation",
      "name": "Slack confirmation",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [300, 520],
      "credentials": {
        "slackApi": {
          "id": "REPLACE",
          "name": "Slack account"
        }
      },
      "disabled": true,
      "notes": "Optional. Enable after setting a Slack channel and credentials."
    }
  ],
  "connections": {
    "Upload Excel": {
      "main": [
        [
          {
            "node": "Normalize uploaded file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize uploaded file": {
      "main": [
        [
          {
            "node": "Analyze on Render",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze on Render": {
      "main": [
        [
          {
            "node": "Email report",
            "type": "main",
            "index": 0
          },
          {
            "node": "Slack confirmation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email report": {
      "main": [[]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}

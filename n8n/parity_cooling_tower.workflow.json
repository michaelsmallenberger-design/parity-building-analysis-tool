{
  "name": "Parity Cooling Tower - Webhook to Sheet to Grok to Render to Email to Slack",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cooling-tower-run",
        "responseMode": "onReceived",
        "responseData": "={{ { \"status\": \"started\" } }}",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-100, 300],
      "webhookId": "cooling-tower-run",
      "notes": "POST to this URL to kick off a run. Responds immediately ('started') so it never times out on a long batch; the rest runs async and confirms via Slack."
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "list",
          "cachedResultName": "Sheet1"
        },
        "options": {}
      },
      "id": "node-sheets",
      "name": "Read addresses",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [120, 300],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "REPLACE", "name": "Google Sheets account" }
      },
      "notes": "Reads every row. Required column: Address. Optional: Boro_Area, Zip."
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You normalize US building addresses for geocoding. Output ONLY one clean line as `number street, city, STATE ZIP` with no commentary and no quotes. Input: {{ [$json.Address, $json.Boro_Area, $json.Zip].filter(Boolean).join(', ') }}"
      },
      "id": "node-llmchain",
      "name": "Normalize (Grok)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [340, 300],
      "notes": "Cleans each row's address with Grok before geocoding. Output field: `text`."
    },
    {
      "parameters": {
        "model": "grok-4.3",
        "options": {}
      },
      "id": "node-grok",
      "name": "Grok Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatXAiGrok",
      "typeVersion": 1,
      "position": [340, 480],
      "credentials": {
        "xAiApi": { "id": "REPLACE", "name": "xAI account" }
      },
      "notes": "If your n8n version lacks the xAI Grok node, swap this for any Chat Model sub-node (OpenAI, Gemini, etc.) — the chain is model-agnostic."
    },
    {
      "parameters": {
        "fieldsToAggregate": {
          "fieldToAggregate": [
            { "fieldToAggregate": "text", "renameField": true, "outputFieldName": "addresses" }
          ]
        },
        "options": {}
      },
      "id": "node-aggregate",
      "name": "Collect addresses",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [560, 300],
      "notes": "Turns the per-row normalized addresses into one list (`addresses`) for the single batch call to Render."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://REPLACE-WITH-RENDER-SERVICE.onrender.com/api/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "REPLACE_WITH_ANALYZE_API_KEY" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { addresses: $json.addresses, title: 'Cooling Tower Analysis' } }}",
        "options": {
          "timeout": 1800000,
          "response": { "response": { "responseFormat": "text" } }
        }
      },
      "id": "node-render",
      "name": "Analyze on Render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 300],
      "notes": "One batch call: Render analyzes every address and returns the finished self-contained HTML report (in $json.data). Long timeout because a big sheet can take many minutes."
    },
    {
      "parameters": {
        "sendTo": "REPLACE@your-email.com",
        "subject": "Cooling Tower Analysis Report",
        "emailType": "html",
        "message": "={{ $json.data }}",
        "options": {}
      },
      "id": "node-email",
      "name": "Email report",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1000, 300],
      "credentials": {
        "gmailOAuth2": { "id": "REPLACE", "name": "Gmail account" }
      },
      "notes": "Inlines the HTML report. Add it as a .html attachment via Options → Attachments if you prefer."
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "REPLACE_WITH_SLACK_CHANNEL_ID",
          "mode": "id"
        },
        "text": "=✅ Cooling tower analysis complete — {{ $('Collect addresses').item.json.addresses.length }} addresses analyzed, report emailed.",
        "otherOptions": {}
      },
      "id": "node-slack",
      "name": "Slack confirmation",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1220, 300],
      "credentials": {
        "slackApi": { "id": "REPLACE", "name": "Slack account" }
      },
      "notes": "Posts a confirmation with the address count once the report is emailed."
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Read addresses", "type": "main", "index": 0 }]] },
    "Read addresses": { "main": [[{ "node": "Normalize (Grok)", "type": "main", "index": 0 }]] },
    "Grok Chat Model": { "ai_languageModel": [[{ "node": "Normalize (Grok)", "type": "ai_languageModel", "index": 0 }]] },
    "Normalize (Grok)": { "main": [[{ "node": "Collect addresses", "type": "main", "index": 0 }]] },
    "Collect addresses": { "main": [[{ "node": "Analyze on Render", "type": "main", "index": 0 }]] },
    "Analyze on Render": { "main": [[{ "node": "Email report", "type": "main", "index": 0 }]] },
    "Email report": { "main": [[{ "node": "Slack confirmation", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
